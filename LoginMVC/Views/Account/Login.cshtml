@model LoginMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container py-5 d-flex align-items-center justify-content-center" style="min-height: 88vh;">
    <div class="card border-0 shadow-lg overflow-hidden rounded-4" style="max-width: 900px; width: 100%;">
        <div class="row g-0">
            <!-- Panel Izquierdo Institucional -->
            <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-5 text-white"
                 style="background: linear-gradient(145deg, #0f172a 0%, #1e3a8a 100%);">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-shield-lock-fill fs-2 text-info"></i>
                        <span class="fs-5 fw-bold tracking-wide">PortalMVC</span>
                    </div>
                    <h2 class="h4 fw-bold mb-3">Control de Acceso Institucional</h2>
                    <p class="small text-white-50 lh-base">
                        Plataforma web desarrollada con arquitectura Modelo-Vista-Controlador (C# .NET) y persistencia segura en Microsoft SQL Server.
                    </p>
                </div>

                <div class="border-top border-secondary pt-3 small text-white-50">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-check-circle-fill text-info"></i>
                        <span>Autenticación protegida por Cookies</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-info"></i>
                        <span>Cifrado SHA-256 en credenciales</span>
                    </div>
                </div>
            </div>

            <!-- Panel Derecho Formulario -->
            <div class="col-lg-7 bg-white p-4 p-md-5">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark mb-1">Bienvenido</h3>
                    <p class="text-muted small mb-0">Ingresa tus credenciales para acceder al panel principal.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show small" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show small" role="alert">
                        <i class="bi bi-info-circle-fill me-1"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Correo" class="form-control" placeholder="usuario@correo.com" />
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" id="inputPasswordLogin" class="form-control" placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('inputPasswordLogin', 'iconoOjoLogin')" title="Mostrar/Ocultar contraseña">
                                <i id="iconoOjoLogin" class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                        </button>
                    </div>

                    <div class="text-center small text-muted">
                        ¿No tienes una cuenta?
                        <a asp-action="Register" asp-controller="Account" class="text-decoration-none fw-semibold">Regístrate aquí</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>
}