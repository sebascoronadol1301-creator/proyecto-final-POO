@model LoginMVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container py-5 d-flex align-items-center justify-content-center" style="min-height: 88vh;">
    <div class="card border-0 shadow-lg rounded-4" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-2" style="width: 52px; height: 52px;">
                    <i class="bi bi-person-plus-fill fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1">Registro de Usuario</h3>
                <p class="text-muted small mb-0">Crea una nueva cuenta en el sistema</p>
            </div>

            <form asp-action="Register" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Sebastian Coronado" />
                    </div>
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Correo" class="form-control" placeholder="nombre@correo.com" />
                    </div>
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-shield-check text-muted"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Registrar Cuenta
                    </button>
                </div>

                <div class="text-center small text-muted">
                    ¿Ya tienes una cuenta?
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none fw-semibold">Inicia sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}