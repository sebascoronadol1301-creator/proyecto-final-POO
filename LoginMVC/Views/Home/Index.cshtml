@{
    ViewData["Title"] = "Panel Principal";
    string usuarioId = ViewBag.UsuarioId ?? "-";
    string nombre = ViewBag.NombreUsuario ?? "Usuario";
    string correo = ViewBag.CorreoUsuario ?? "";
    string rol = ViewBag.RolUsuario ?? "Estudiante";
    string ultimoAcceso = ViewBag.UltimoAcceso ?? "Primer inicio de sesión";
    string horaSesion = ViewBag.HoraSesion ?? "";
}

<div class="container py-5">
    <!-- Banner Superior de Bienvenida -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden"
         style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="badge bg-success bg-opacity-75 mb-2 px-3 py-2">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.55rem;"></i> Sesión activa verificada
                    </span>
                    <h1 class="h2 fw-bold mb-2">¡Bienvenido de nuevo, @nombre!</h1>
                    <p class="text-white-50 mb-0">
                        Has ingresado correctamente al Panel Principal del Sistema de Control de Acceso.
                    </p>
                </div>

                <form asp-action="Logout" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-light text-dark fw-semibold px-4 py-2 shadow-sm">
                        <i class="bi bi-box-arrow-right me-1 text-danger"></i> Cerrar Sesión
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tarjetas de Resumen (KPIs) -->
    <div class="row g-4">
        <!-- Tarjeta 1: Perfil de Usuario -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted small text-uppercase mb-0">Perfil de Usuario</h6>
                            <span class="fw-bold fs-5">ID #@usuarioId</span>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25" />
                    <p class="small mb-1"><strong>Nombre:</strong> @nombre</p>
                    <p class="small text-muted mb-0 text-truncate"><strong>Correo:</strong> @correo</p>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Detalles de Sesión -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted small text-uppercase mb-0">Actividad de Acceso</h6>
                            <span class="fw-bold fs-5">En línea</span>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25" />
                    <p class="small mb-1"><strong>Sesión actual:</strong> @horaSesion</p>
                    <p class="small text-muted mb-0"><strong>Acceso anterior:</strong> @ultimoAcceso</p>
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Seguridad y Rol -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                            <i class="bi bi-shield-check fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted small text-uppercase mb-0">Nivel y Seguridad</h6>
                            <span class="fw-bold fs-5">@rol</span>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25" />
                    <p class="small mb-1"><strong>Base de datos:</strong> SQL Server</p>
                    <p class="small text-muted mb-0"><strong>Cifrado:</strong> SHA-256 + Cookie Auth</p>
                </div>
            </div>
        </div>
    </div>
</div>